{
  "name": "transitive-bullshit-personal-site",
  "version": "0.0.0",
  "private": true,
  "description": "My own little corner of the web",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "https://github.com/transitive-bullshit/personal-site",
  "type": "module",
  "scripts": {
    "dev": "portless run --force next dev --hostname 127.0.0.1",
    "build": "next build --webpack && tsx scripts/verify-social-image-bundle.ts",
    "start": "next start",
    "test": "run-s test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:types": "next typegen && tsc --noEmit",
    "lint": "pnpm test:lint",
    "typecheck": "pnpm test:types",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "content:sync": "tsx scripts/sync.ts",
    "content:bookmark-images": "tsx scripts/backfill-bookmark-screenshots.ts",
    "content:videos": "tsx scripts/backfill-videos.ts",
    "content:search": "tsx scripts/build-search-index.ts",
    "content:previews": "tsx scripts/build-link-previews.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@takumi-rs/core": "2.14.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cuelume": "^0.2.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "p-map": "^7.1.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-tweet": "^3.3.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "takumi-js": "^2.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fisch0920/config": "^2.3.0",
    "@notionhq/client": "^5.27.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "cheerio": "^1.2.0",
    "lint-staged": "^17.6.0",
    "notion-client": "^8.0.8",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.0",
    "portless": "^0.15.7",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tasuku": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
